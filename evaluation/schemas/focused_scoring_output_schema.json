    "EventEvaluation": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^E[0-9]{3,}$",
          "title": "Event Id",
          "type": "string"
        },
        "d1": {
          "$ref": "#/$defs/D1Result"
        },
        "d2": {
          "$ref": "#/$defs/D2Result"
        },
        "d3": {
          "$ref": "#/$defs/D3Result"
        },
        "narrative_salience": {
          "enum": [
            "S1",
            "S2",
            "S3"
          ],
          "title": "Narrative Salience",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[PT][0-9]{3,}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "d1",
        "d2",
        "d3",
        "narrative_salience",
        "evidence_ids",
        "summary"
      ],
      "title": "EventEvaluation",
      "type": "object"
    },
    "LiteraryDimensions": {
